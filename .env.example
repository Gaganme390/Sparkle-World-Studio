# ==============================================================================
# Environment Configuration for GD Goenka Ayodhya School
# ==============================================================================

# Server Port
PORT=5000
NODE_ENV=production

# ------------------------------------------------------------------------------
# PostgreSQL Database Connection
# ------------------------------------------------------------------------------
# Choose any one of the options below and set DATABASE_URL:

# 1. Render PostgreSQL (Recommended for Render deployment)
# Render automatically injects DATABASE_URL if you link a Render PostgreSQL database.
# Format: postgresql://gd_user:password@dpg-xxxxxx.render.com/gd_goenka_db

# 2. Supabase PostgreSQL (Free cloud DB)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# 3. Neon PostgreSQL (Serverless cloud DB)
# DATABASE_URL=postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require

# 4. Local Docker Compose (Automatic when running `docker compose up`)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/gd_goenka_db

# 5. Local PostgreSQL installed on your machine
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=gd_goenka_db
# PGUSER=postgres
# PGPASSWORD=postgres
